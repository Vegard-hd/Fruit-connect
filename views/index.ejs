<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head.ejs') %>
  <body class="container-fluid">
    <section id="gameScoreDisplay" class="row">
      <h2 class="text-bg-warning pt-3 pb-3 text-center">
        Score is:
        <i class="fs-1 text-success text-decoration-underline" id="gameScore">
          0</i
        >
        <div>&nbsp;</div>
        Time left:
        <i class="fs-1 text-danger text-decoration-underline" id="movesLeft">
          10</i
        >
        <i
          class="fs-1 text-danger text-decoration-underline"
          id="timeLeftDisplay"
        >
          10</i
        >
      </h2>
      <div class="container-sm w-25 text-nowrap">
        <h3>
          Bonus fruit:
          <img
            id="bonusFruit"
            src=""
            alt="image of the fruit that gives bonus score"
          />
        </h3>
        <div class="progress" role="progressbar">
          <div id="bonusFruitProgress" class="progress-bar" style="width: 50%">
            25%
          </div>
        </div>
      </div>
    </section>
    <header>
      <h1 class="text-center fs-1 mt-5 text-danger text-decoration-underline">
        Fruit-connect
      </h1>
    </header>
    <main class="container-fluid gap-0 text-center" style="max-width: 800px">
      <section id="gameContainer" class="row g-0">
        <div id="gridWrapper" class="col-md-8 col-12">
          <div id="row1"></div>
          <div id="row2"></div>
          <div id="row3"></div>
          <div id="row4"></div>
          <div id="row5"></div>
          <div id="row6"></div>
          <div id="row7"></div>
          <div id="row8"></div>
          <div id="row9"></div>
          <div id="row10"></div>
          <div id="row11"></div>
          <div id="row12"></div>
        </div>
        <div class="col-md-4 col-12">
          <%- include('./partials/scoreTable.ejs') %>
        </div>
      </section>
    </main>
  </body>
  <%- include('./partials/script.ejs') %>
</html>
